# Environment variables
# NOTE: For server-side operations use the SERVICE_ROLE key (keep it secret).
# You can store these as GitHub Secrets when running in Actions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Optional: comma-separated list of stock symbols to track
# If empty, will use default list from database
STOCK_SYMBOLS=VCB,VNM,FPT,HPG,GAS,MSN,VHM,TCB,MWG,SSI,VIC,VHM,SHB

# The live workflow runs every 2 hours and scans 3 hours to tolerate delayed runs.
NEWS_WINDOW_HOURS=3

# International feeds may update less frequently, especially on weekends.
INTERNATIONAL_NEWS_WINDOW_HOURS=72

# Single mode setting: TEST sends recent news immediately; LIVE follows the schedule.
RUN_MODE=TEST

LOG_LEVEL=info
